# Copy to .env.local and fill in to connect the site to Supabase.
# Leave the key empty and the site runs in demo mode: forms validate but nothing is saved.
#
# Project URL (not a secret). Found in Supabase -> Project Settings -> API.
VITE_SUPABASE_URL=https://sktcymapzkiqlxnmkwbs.supabase.co
# The ANON / publishable key ONLY. Never put the service_role key (or any database password) in this file.
VITE_SUPABASE_ANON_KEY=
